{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PrintKilat: Jalankan Flask (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "PORT": "5000"
      }
    },
    {
      "name": "PrintKilat: Jalankan Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal"
    }
  ]
}
